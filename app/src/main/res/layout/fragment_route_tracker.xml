<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Карта на весь экран -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Индикатор загрузки -->
    <RelativeLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_gradient"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@android:color/white" />

            <TextView
                android:id="@+id/tvLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Загрузка..."
                android:textColor="@android:color/white"
                android:textSize="16sp" />

        </LinearLayout>

    </RelativeLayout>

    <!-- Выдвижная шторка слева -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/left_sheet_background"
        android:elevation="24dp"
        android:layout_marginBottom="110dp"
        android:outlineProvider="bounds"
        android:layout_gravity="start">

        <!-- Заголовок шторки -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:background="@drawable/header_gradient">

            <!-- Ручка для перетаскивания (вертикальная) -->
            <View
                android:layout_width="4dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/drag_handle_gradient" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRouteName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Статистика маршрута"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2" />

                <TextView
                    android:id="@+id/tvRouteDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Сегодня"
                    android:textSize="12sp"
                    android:textColor="#CCFFFFFF"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Кнопка закрытия -->
            <ImageButton
                android:id="@+id/btnCloseSheet"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_close"
                android:background="@drawable/circle_ripple"
                app:tint="@android:color/white"
                android:contentDescription="Закрыть" />

        </LinearLayout>

        <!-- Контент статистики с прокруткой -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="20dp"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/statsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Дистанция -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="🛣️"
                        android:textSize="16sp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Дистанция"
                            android:textSize="12sp"
                            android:textColor="#666666"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/Distance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0 км"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Время -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="⏱️"
                        android:textSize="16sp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Время"
                            android:textSize="12sp"
                            android:textColor="#666666"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/tvTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0 мин"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Средняя скорость -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="🚶"
                        android:textSize="16sp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Средняя скорость"
                            android:textSize="12sp"
                            android:textColor="#666666"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/AvgSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0 км/ч"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Максимальная скорость -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="💨"
                        android:textSize="16sp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Макс. скорость"
                            android:textSize="12sp"
                            android:textColor="#666666"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/MaxSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0 км/ч"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Калории -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="🔥"
                        android:textSize="16sp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Сожжено калорий"
                            android:textSize="12sp"
                            android:textColor="#666666"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/Calories"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0 ккал"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Дополнительная статистика -->
                <LinearLayout
                    android:id="@+id/paceContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="🏃"
                        android:textSize="16sp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Темп"
                            android:textSize="12sp"
                            android:textColor="#666666"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/tvPace"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0:00 мин/км"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Кнопки управления -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"
            android:background="@android:color/transparent">

            <Button
                android:id="@+id/btnClear"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Очистить маршрут"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/button_brown_gradient"
                android:textColor="@android:color/white"
                android:stateListAnimator="@null"
                android:elevation="4dp"
                android:translationZ="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Верхние FAB кнопки -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:gravity="end">

        <!-- Кнопка для управления шторкой -->
        <ImageButton
            android:id="@+id/btnToggleSheet"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/fab_background"
            android:src="@drawable/ic_create_new_playlist"
            android:contentDescription="Показать статистику"
            android:elevation="8dp"
            android:translationZ="8dp"
            android:layout_marginBottom="12dp" />

        <!-- FAB для центрирования карты -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabCenterMap"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_location_off"
            android:contentDescription="Центрировать карту"
            app:backgroundTint="@color/colorPrimary"
            app:elevation="8dp"
            app:maxImageSize="28dp"
            app:rippleColor="@color/colorPrimaryDark"
            android:layout_marginBottom="12dp" />

        <!-- FAB для экспорта -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabExport"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_sawmill"
            android:contentDescription="Экспорт маршрута"
            app:backgroundTint="@color/colorPrimary"
            app:elevation="8dp"
            app:maxImageSize="28dp"
            app:rippleColor="@color/colorPrimaryDark"
            android:visibility="gone"/>

        <!-- FAB для управления трекингом -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabStartStop"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="bottom|end"
           android:layout_marginTop="10dp"
            android:src="@drawable/ic_play"
            android:contentDescription="Начать/остановить трекинг"
            app:backgroundTint="@color/colorAccent"
            app:elevation="12dp"
            app:maxImageSize="32dp"
            app:rippleColor="@color/colorAccentDark"
            app:fabSize="normal" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>